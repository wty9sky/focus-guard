{
  "manifest_version": 3,
  "name": "专注守门员 · Focus Guard",
  "version": "1.0.0",
  "description": "网站访问自我节制：黑名单、一键屏蔽、定时屏蔽、白屏警告拦截，配套积分奖励与惩罚机制。",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "专注守门员",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
